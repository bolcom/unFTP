FROM rust:1.99.1-slim AS builder

FROM scratch

LABEL org.opencontainers.image.source="https://github.com/Cloudinvoke/unFTP" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.vendor="CloudInvoke"

ARG TARGETARCH

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --chown=1010:1010 --from=builder /srv /srv
COPY --chown=1010:1010 --chmod=755 ./linux/${TARGETARCH}/unftp /unftp

VOLUME /srv
USER 1010
CMD ["/unftp", "-vv"]
